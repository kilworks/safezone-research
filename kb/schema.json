{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safezone-research/kb/schema.json",
  "$defs": {
    "label": {"enum": ["DOCUMENTED", "DERIVED", "CONDITIONAL", "CORROBORATED", "HYPOTHESIS", "CONTRADICTED", "UNKNOWN"]},
    "mid": {"type": "string", "pattern": "^M-[0-9]{4}$"},
    "uid": {"type": "string", "pattern": "^U-[0-9]{4}$"},
    "eid": {"type": "string", "pattern": "^E-[0-9]{4}$"},
    "cid": {"type": "string", "pattern": "^C-[0-9]{4}$"},
    "tid": {"type": "string", "pattern": "^T-[0-9]{4}$"},
    "clause": {"type": "string", "pattern": "^[a-z0-9-]+-[0-9]{3}$"},
    "source": {
      "type": "object",
      "required": ["url", "snapshot", "quote", "clause"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "snapshot": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "quote": {"type": "string", "minLength": 1},
        "clause": {"$ref": "#/$defs/clause"}
      }
    },
    "mechanic": {
      "type": "object",
      "required": ["id", "name", "family", "sigils", "sources", "formal", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/mid"},
        "name": {"type": "string", "minLength": 3},
        "family": {"enum": ["damage", "healing", "economy", "items", "weapons", "sigil", "zombies", "poison", "zone", "revival", "viewer"]},
        "sigils": {"type": "array", "minItems": 1, "items": {"enum": ["all", "piety", "greed", "ingenuity", "trolling", "death", "endurance", "necromancy", "protection", "healing"]}},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "formal": {
          "type": "object",
          "required": ["readings"],
          "additionalProperties": false,
          "properties": {
            "readings": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
            "domain": {"type": "string"},
            "parameters": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/mid"}},
        "interacts_with": {"type": "array", "items": {"$ref": "#/$defs/mid"}},
        "label": {"$ref": "#/$defs/label"},
        "open_unknowns": {"type": "array", "items": {"$ref": "#/$defs/uid"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/eid"}},
        "theorems": {"type": "array", "items": {"$ref": "#/$defs/tid"}},
        "notes": {"type": "string"}
      }
    },
    "unknown": {
      "type": "object",
      "required": ["id", "question", "why_it_matters", "resolution_paths", "priority", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uid"},
        "question": {"type": "string"},
        "why_it_matters": {"type": "string"},
        "readings": {"type": "object", "additionalProperties": {"type": "string"}},
        "parameter": {"type": "string"},
        "sweep_range": {"type": "string"},
        "resolution_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "priority": {"enum": ["critical", "high", "medium", "low"]},
        "status": {"enum": ["open", "resolved", "unresolvable"]},
        "resolution": {"type": "string"},
        "related": {"type": "array", "items": {"type": "string", "pattern": "^[MUECT]-[0-9]{4}$"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "locator", "captured", "summary", "supports", "contradicts"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/eid"},
        "kind": {"enum": ["wiki", "wayback", "rea", "vod", "organizer", "derivation"]},
        "locator": {"type": "string"},
        "captured": {"type": "string"},
        "summary": {"type": "string"},
        "supports": {"type": "array", "items": {"type": "string", "pattern": "^[MUCT]-[0-9]{4}$"}},
        "contradicts": {"type": "array", "items": {"type": "string", "pattern": "^[MUCT]-[0-9]{4}$"}}
      }
    },
    "contradiction": {
      "type": "object",
      "required": ["id", "summary", "sides", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/cid"},
        "summary": {"type": "string"},
        "sides": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/source"}},
        "mechanics": {"type": "array", "items": {"$ref": "#/$defs/mid"}},
        "status": {"enum": ["open", "resolved", "explained"]},
        "resolution": {"type": "string"}
      }
    },
    "flavor": {
      "type": "object",
      "required": ["clauses"],
      "additionalProperties": false,
      "properties": {
        "clauses": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
